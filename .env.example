# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only, used in Edge Functions / API routes that need elevated access.
# NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to HMAC-sign QR ticket payloads (32+ random bytes, e.g. `openssl rand -hex 32`)
TICKET_SIGNING_SECRET=replace-with-a-long-random-secret

# Resend (or swap for your provider) for confirmation emails sent from the Edge Function
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Events <tickets@yourdomain.com>"

NEXT_PUBLIC_SITE_URL=http://localhost:3000
